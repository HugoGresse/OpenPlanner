{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "declaration": false,
        "sourceMap": false,
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts"]
}
